# Copy to .env (never committed: .gitignore) and fill in.

# Tailscale auth key for the "vault" device: admin console -> Settings ->
# Keys -> Generate auth key, tagged tag:vault, NOT ephemeral (Vault should
# stay on the tailnet), reusable off. Only used on the first start; after
# that the device's state is in the tailscale-state volume.
TS_AUTHKEY=

# KMS auto-unseal, from terraform/vault (run there):
#   terraform output -raw unseal_access_key_id
#   terraform output -raw unseal_secret_access_key
#   terraform output -raw kms_key_id
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
VAULT_AWSKMS_SEAL_KEY_ID=

# Backup token (after `vault operator init` and terraform/vault-config):
#   vault token create -policy=raft-snapshot -period=768h -orphan -field=token
VAULT_BACKUP_TOKEN=

# Where snapshots go: a local folder, or a mounted NFS share (better: another
# machine). Default ./backups.
BACKUP_DIR=
